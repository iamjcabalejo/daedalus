{
  "schema": "daedalus.probe-case/1",
  "id": "E4",
  "title": "Failure semantics: missing-interpreter",
  "refs": [
    "R-AC-1e",
    "D9"
  ],
  "applies_to": {
    "installs": [
      "script",
      "plugin"
    ],
    "hosts": [
      "claude"
    ]
  },
  "files": {
    "script": [
      {
        "template": "script/settings.failure.json",
        "dest": "repo/.claude/settings.json"
      }
    ],
    "plugin": [
      {
        "template": "plugin/plugin.json",
        "dest": "probe-plugin/.claude-plugin/plugin.json"
      },
      {
        "template": "plugin/hooks.failure.json",
        "dest": "probe-plugin/hooks/hooks.json"
      },
      {
        "template": "plugin/project-settings.json",
        "dest": "repo/.claude/settings.json"
      }
    ]
  },
  "vars": {
    "interpreter": "/nonexistent/daedalus-probe-python3"
  },
  "ctrl": [],
  "stimulus": {
    "prompt": "Run `touch marker-E4` with the Bash tool, then reply done. If it is blocked, say so and don't retry."
  },
  "flags": {
    "max_turns": 4,
    "max_budget_usd": 0.1
  },
  "observations": [
    {
      "id": "marker",
      "kind": "marker",
      "role": "assert",
      "description": "marker-E4 exists (fail-open) or not (blocked).",
      "path": "marker-E4",
      "expect": true
    },
    {
      "id": "bash-issued",
      "kind": "stream",
      "check": "tool-use",
      "role": "precondition",
      "names": [
        "Bash"
      ],
      "description": "The assistant issued a Bash tool_use for the touch (stream-json assistant event; verify in T0). The hook can't show the attempt: its interpreter doesn't exist.",
      "where": [
        {
          "field": "input.command",
          "op": "contains",
          "value": "marker-E4"
        }
      ]
    },
    {
      "id": "bash-ran",
      "kind": "event",
      "role": "record",
      "description": "PostToolUse for the touch (the command ran).",
      "event": "PostToolUse",
      "where": [
        {
          "field": "tool_name",
          "op": "equals",
          "value": "Bash"
        },
        {
          "field": "tool_input.command",
          "op": "contains",
          "value": "marker-E4"
        }
      ],
      "expect": "present"
    },
    {
      "id": "hook-ran",
      "kind": "event",
      "role": "record",
      "description": "The recorder saw the PreToolUse (absent for a missing interpreter).",
      "event": "PreToolUse",
      "where": [
        {
          "field": "tool_name",
          "op": "equals",
          "value": "Bash"
        },
        {
          "field": "tool_input.command",
          "op": "contains",
          "value": "marker-E4"
        }
      ],
      "expect": "present"
    }
  ],
  "status_rules": {
    "evaluate": "auto",
    "confirmed": "each variant's marker matches the documented behavior (without onFailure: fail-open; with onFailure: block: blocked)",
    "contradicted": "a variant's marker contradicts the documented behavior",
    "inconclusive": "the host didn't run or timed out, or the stream shows no Bash tool_use for the touch (the call was never attempted)"
  },
  "variants": [
    {
      "id": "default",
      "description": "the hook command names an interpreter that doesn't exist; no onFailure key",
      "vars": {
        "on_failure": null
      },
      "observations": [
        {
          "id": "marker",
          "kind": "marker",
          "role": "assert",
          "description": "marker-E4 exists (fail-open) or not (blocked).",
          "path": "marker-E4",
          "expect": true
        },
        {
          "id": "bash-issued",
          "kind": "stream",
          "check": "tool-use",
          "role": "precondition",
          "names": [
            "Bash"
          ],
          "description": "The assistant issued a Bash tool_use for the touch (stream-json assistant event; verify in T0). The hook can't show the attempt: its interpreter doesn't exist.",
          "where": [
            {
              "field": "input.command",
              "op": "contains",
              "value": "marker-E4"
            }
          ]
        },
        {
          "id": "bash-ran",
          "kind": "event",
          "role": "record",
          "description": "PostToolUse for the touch (the command ran).",
          "event": "PostToolUse",
          "where": [
            {
              "field": "tool_name",
              "op": "equals",
              "value": "Bash"
            },
            {
              "field": "tool_input.command",
              "op": "contains",
              "value": "marker-E4"
            }
          ],
          "expect": "present"
        },
        {
          "id": "hook-ran",
          "kind": "event",
          "role": "record",
          "description": "The recorder saw the PreToolUse (absent for a missing interpreter).",
          "event": "PreToolUse",
          "where": [
            {
              "field": "tool_name",
              "op": "equals",
              "value": "Bash"
            },
            {
              "field": "tool_input.command",
              "op": "contains",
              "value": "marker-E4"
            }
          ],
          "expect": "present"
        }
      ]
    },
    {
      "id": "on-failure-block",
      "description": "the hook command names an interpreter that doesn't exist; onFailure: \"block\"",
      "vars": {
        "on_failure": "block"
      },
      "observations": [
        {
          "id": "marker",
          "kind": "marker",
          "role": "assert",
          "description": "marker-E4 exists (fail-open) or not (blocked).",
          "path": "marker-E4",
          "expect": false
        },
        {
          "id": "bash-issued",
          "kind": "stream",
          "check": "tool-use",
          "role": "precondition",
          "names": [
            "Bash"
          ],
          "description": "The assistant issued a Bash tool_use for the touch (stream-json assistant event; verify in T0). The hook can't show the attempt: its interpreter doesn't exist.",
          "where": [
            {
              "field": "input.command",
              "op": "contains",
              "value": "marker-E4"
            }
          ]
        },
        {
          "id": "bash-ran",
          "kind": "event",
          "role": "record",
          "description": "PostToolUse for the touch (the command ran).",
          "event": "PostToolUse",
          "where": [
            {
              "field": "tool_name",
              "op": "equals",
              "value": "Bash"
            },
            {
              "field": "tool_input.command",
              "op": "contains",
              "value": "marker-E4"
            }
          ],
          "expect": "present"
        },
        {
          "id": "hook-ran",
          "kind": "event",
          "role": "record",
          "description": "The recorder saw the PreToolUse (absent for a missing interpreter).",
          "event": "PreToolUse",
          "where": [
            {
              "field": "tool_name",
              "op": "equals",
              "value": "Bash"
            },
            {
              "field": "tool_input.command",
              "op": "contains",
              "value": "marker-E4"
            }
          ],
          "expect": "present"
        }
      ]
    }
  ],
  "notes": [
    "Record the host version with every E result (D9: minimum version for onFailure).",
    "The onFailure hook key is [D]: verify in T0.",
    "verify in T0: permission rule syntax in the templates (Bash(echo *), WebFetch(domain:...), mcp__...)",
    "verify in T0: the stream-json assistant tool_use shape that bash-issued reads"
  ]
}
