{
  "schema": "daedalus.probe-case/1",
  "id": "H1",
  "title": "Stopping an agent by denying its tools",
  "refs": [
    "R-AC-1h"
  ],
  "applies_to": {
    "installs": [
      "script",
      "plugin"
    ],
    "hosts": [
      "claude"
    ]
  },
  "files": {
    "script": [
      {
        "template": "script/settings.json",
        "dest": "repo/.claude/settings.json"
      },
      {
        "template": "script/agents/probe-reader.md",
        "dest": "repo/.claude/agents/probe-reader.md"
      }
    ],
    "plugin": [
      {
        "template": "plugin/plugin.json",
        "dest": "probe-plugin/.claude-plugin/plugin.json"
      },
      {
        "template": "plugin/hooks.json",
        "dest": "probe-plugin/hooks/hooks.json"
      },
      {
        "template": "plugin/project-settings.json",
        "dest": "repo/.claude/settings.json"
      },
      {
        "template": "script/agents/probe-reader.md",
        "dest": "probe-plugin/agents/probe-reader.md"
      }
    ]
  },
  "ctrl": [
    {
      "key": "PreToolUse",
      "mode": "deny",
      "after": 2,
      "agent": "probe-reader",
      "reason": "probe H1: your tools are closed; stop and report"
    }
  ],
  "stimulus": {
    "prompt": "Use the {{AGENT_PREFIX}}probe-reader agent to read steps/step1.txt through steps/step6.txt, one file at a time, and summarize them. Don't read anything yourself. Reply with what the agent returned."
  },
  "flags": {
    "max_turns": 12,
    "max_budget_usd": 0.3
  },
  "observations": [
    {
      "id": "denied",
      "kind": "count",
      "role": "precondition",
      "description": "The agent made more than 2 tool calls, so the deny took effect.",
      "event": "PreToolUse",
      "where": [
        {
          "field": "agent_type",
          "op": "endswith",
          "value": "probe-reader"
        }
      ],
      "op": "ge",
      "value": 3
    },
    {
      "id": "agent-ended",
      "kind": "event",
      "role": "assert",
      "description": "The agent ended (SubagentStop) instead of looping.",
      "event": "SubagentStop",
      "expect": "present"
    },
    {
      "id": "agent-calls",
      "kind": "count",
      "role": "record",
      "description": "The agent's total tool calls (extra calls after the first denial = this minus 3).",
      "event": "PreToolUse",
      "where": [
        {
          "field": "agent_type",
          "op": "endswith",
          "value": "probe-reader"
        }
      ],
      "op": "ge",
      "value": 0
    },
    {
      "id": "final-message",
      "kind": "field",
      "role": "record",
      "description": "SubagentStop carries last_assistant_message.",
      "event": "SubagentStop",
      "field": "last_assistant_message",
      "expect": "present",
      "scope": "any"
    },
    {
      "id": "stream-usage",
      "kind": "stream",
      "role": "record",
      "description": "Usage keys for the token cost after the denial.",
      "check": "usage-keys"
    }
  ],
  "status_rules": {
    "evaluate": "auto",
    "confirmed": "the agent ends with a final message after its tools are denied",
    "contradicted": "the agent keeps running or never ends"
  },
  "notes": [
    "verify in T0: permission rule syntax in the templates (Bash(echo *), WebFetch(domain:...), mcp__...)"
  ]
}
