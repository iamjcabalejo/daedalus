+// normalizeEmail is the canonical form of an email address: trimmed and lowercased.
+func normalizeEmail(email string) string {
+	return strings.ToLower(strings.TrimSpace(email))
+}
+
+// FindUserByEmail looks a user up by email regardless of letter case, so accounts
+// stored before emails were normalized are still found.
+func FindUserByEmail(email string) (UserModel, error) {
+	db := common.GetDB()
+	var model UserModel
+	err := db.Where("LOWER(email) = ?", normalizeEmail(email)).First(&model).Error
+	return model, err
+}
