+const DEFAULT_PAGE_SIZE = 10;
+const MAX_PAGE_SIZE = 100;
+
+const toWholeNumber = (value: unknown): number | undefined => {
+  if (typeof value === 'number') {
+    return Number.isInteger(value) ? value : undefined;
+  }
+  if (typeof value === 'string' && /^-?\d+$/.test(value.trim())) {
+    return Number(value.trim());
+  }
+  return undefined;
+};
+
+// Page size: a whole number from 1 to MAX_PAGE_SIZE; anything else falls back to the default.
+const pageLimit = (value: unknown): number => {
+  const limit = toWholeNumber(value);
+  if (limit === undefined || limit < 1) {
+    return DEFAULT_PAGE_SIZE;
+  }
+  return Math.min(limit, MAX_PAGE_SIZE);
+};
+
+// Offset: a whole number of at least 0; anything else starts at the first article.
+const pageOffset = (value: unknown): number => {
+  const offset = toWholeNumber(value);
+  return offset === undefined || offset < 0 ? 0 : offset;
+};
