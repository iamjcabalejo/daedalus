+// findArticleUserID resolves a username to its ArticleUserModel id. It reports
+// false when the user, or their article-side record, doesn't exist.
+func findArticleUserID(username string) (uint, bool) {
+	db := common.GetDB()
+	var userModel users.UserModel
+	if err := db.Where(users.UserModel{Username: username}).First(&userModel).Error; err != nil {
+		return 0, false
+	}
+	var articleUserModel ArticleUserModel
+	if err := db.Where(ArticleUserModel{UserModelID: userModel.ID}).First(&articleUserModel).Error; err != nil {
+		return 0, false
+	}
+	return articleUserModel.ID, true
+}
