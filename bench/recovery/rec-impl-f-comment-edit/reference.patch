+export const updateComment = async (
+  body: unknown,
+  slug: string,
+  commentId: number,
+  userId: number,
+) => {
+  const text = typeof body === 'string' ? body.trim() : '';
+
+  if (!text) {
+    throw new HttpException(422, { errors: { body: ["can't be blank"] } });
+  }
+
+  if (!Number.isInteger(commentId)) {
+    throw new HttpException(404, { errors: { comment: ['not found'] } });
+  }
+
+  const comment = await prisma.comment.findFirst({
+    where: {
+      id: commentId,
+      article: {
+        slug,
+      },
+    },
+    select: {
+      authorId: true,
+    },
+  });
+
+  if (!comment) {
+    throw new HttpException(404, { errors: { comment: ['not found'] } });
+  }
+
+  if (comment.authorId !== userId) {
+    throw new HttpException(403, {
+      message: 'You are not authorized to edit this comment',
+    });
+  }
+
+  const updated = await prisma.comment.update({
+    where: {
+      id: commentId,
+    },
+    data: {
+      body: text,
+      updatedAt: new Date(),
+    },
+    include: {
+      author: {
+        select: {
+          username: true,
+          bio: true,
+          image: true,
+          followedBy: true,
+        },
+      },
+    },
+  });
+
+  return {
+    id: updated.id,
+    createdAt: updated.createdAt,
+    updatedAt: updated.updatedAt,
+    body: updated.body,
+    author: {
+      username: updated.author.username,
+      bio: updated.author.bio,
+      image: updated.author.image,
+      following: updated.author.followedBy.some((follow: any) => follow.id === userId),
+    },
+  };
+};
+
