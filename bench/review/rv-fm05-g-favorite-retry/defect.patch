+func TestRetryWhileBusyRetriesUntilSuccess(t *testing.T) {
+	asserts := assert.New(t)
+
+	attempts := 0
+	err := retryWhileBusy(func() error {
+		attempts++
+		if attempts < 3 {
+			return fmt.Errorf("database is locked")
+		}
+		return nil
+	})
+
+	asserts.NoError(err)
+	asserts.Equal(3, attempts, "the write should run until it succeeds")
+}
