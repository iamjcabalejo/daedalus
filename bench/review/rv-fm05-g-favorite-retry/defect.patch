+// busyRetryDelay is how long a favorite write waits before retrying when
+// SQLite reports the database as locked by a concurrent writer.
+const busyRetryDelay = 50 * time.Millisecond
+
+// retryWhileBusy runs write until it succeeds, pausing between attempts so a
+// concurrent writer can release the SQLite lock.
+func retryWhileBusy(write func() error) error {
+	for {
+		err := write()
+		if err == nil {
+			return nil
+		}
+		time.Sleep(busyRetryDelay)
+	}
+}
