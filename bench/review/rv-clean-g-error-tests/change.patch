+func TestNewErrorMessage(t *testing.T) {
+	asserts := assert.New(t)
+
+	commonError := NewErrorMessage("article", "not found")
+
+	asserts.Equal(map[string][]string{"article": {"not found"}}, commonError.Errors)
+}
+
+func TestMarkInvalidFields(t *testing.T) {
+	asserts := assert.New(t)
+
+	commonError := CommonError{Errors: map[string][]string{"title": {"can't be blank"}}}
+	commonError.MarkInvalidFields([]string{"title", "body"})
+
+	asserts.Equal([]string{"is invalid"}, commonError.Errors["title"], "existing messages are replaced")
+	asserts.Equal([]string{"is invalid"}, commonError.Errors["body"], "missing fields are added")
+}
+
+func TestErrorFieldName(t *testing.T) {
+	asserts := assert.New(t)
+
+	asserts.Equal("tagList", errorFieldName("Tags"))
+	asserts.Equal("tagList", errorFieldName("TagList"))
+	asserts.Equal("title", errorFieldName("Title"))
+}
