new file mode 100644
index 0000000..853c1ba
--- /dev/null
+++ b/src/app/routes/notification/notification.controller.ts
@@ -0,0 +1,26 @@
+import { NextFunction, Request, Response, Router } from 'express';
+import auth from '../auth/auth';
+import { getNotifications } from './notification.service';
+
+const router = Router();
+
+/**
+ * Get the current user's latest notifications
+ * @auth required
+ * @route {GET} /notifications
+ * @returns notifications list of notifications, newest first
+ */
+router.get(
+  '/notifications',
+  auth.required,
+  async (req: Request, res: Response, next: NextFunction) => {
+    try {
+      const notifications = await getNotifications(req.auth?.user?.id);
+      res.json({ notifications });
+    } catch (error) {
+      next(error);
+    }
+  },
+);
+
+export default router;
