diff --git a/src/app/routes/notification/notification.service.ts b/src/app/routes/notification/notification.service.ts
new file mode 100644
index 0000000..43547cd
--- /dev/null
+++ b/src/app/routes/notification/notification.service.ts
@@ -0,0 +1,27 @@
+import prisma from '../../../prisma/prisma-client';
+import { Notification } from './notification.model';
+
+const NOTIFICATIONS_PAGE_SIZE = 20;
+
+export const getNotifications = async (id: number): Promise<Notification[]> =>
+  prisma.notification.findMany({
+    where: {
+      recipientId: id,
+    },
+    orderBy: {
+      createdAt: 'desc',
+    },
+    take: NOTIFICATIONS_PAGE_SIZE,
+    select: {
+      id: true,
+      type: true,
+      createdAt: true,
+      readAt: true,
+      actor: {
+        select: {
+          username: true,
+          image: true,
+        },
+      },
+    },
+  });
