diff --git a/src/app/routes/article/reading-time.utils.ts b/src/app/routes/article/reading-time.utils.ts
new file mode 100644
index 0000000..7d388bc
--- /dev/null
+++ b/src/app/routes/article/reading-time.utils.ts
@@ -0,0 +1,11 @@
+const WORDS_PER_MINUTE = 200;
+
+/**
+ * Estimated reading time of an article body, in whole minutes (at least 1).
+ */
+const estimateReadingTime = (body: string): number => {
+  const words = body.trim().split(/\s+/).filter(Boolean).length;
+  return Math.max(1, Math.ceil(words / WORDS_PER_MINUTE));
+};
+
+export default estimateReadingTime;
