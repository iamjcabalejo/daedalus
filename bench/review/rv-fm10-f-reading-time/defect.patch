@@ -0,0 +1,13 @@
+import estimateReadingTime from '../../app/routes/article/reading-time.utils';
+
+describe('estimateReadingTime', () => {
+  test('should round up to whole minutes', () => {
+    const body = Array(450).fill('word').join(' ');
+
+    expect(estimateReadingTime(body)).toBe(3);
+  });
+
+  test('should never be less than one minute', () => {
+    expect(estimateReadingTime('A short body')).toBe(1);
+  });
+});
