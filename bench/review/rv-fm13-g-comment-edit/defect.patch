+// UpdateBody saves a new body for an existing comment.
+func (model *CommentModel) UpdateBody(body string) error {
+	db := common.GetDB()
+	if err := db.Model(model).Update("body", body).Error; err != nil {
+		return err
+	}
+	model.Body = body
+	return nil
+}
