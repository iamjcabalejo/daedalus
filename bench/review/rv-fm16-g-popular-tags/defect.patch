+// getPopularTags returns the tags used by at least one live article, most
+// used first.
+func getPopularTags() ([]TagModel, error) {
+	db := common.GetDB()
+	var models []TagModel
+	if err := db.Find(&models).Error; err != nil {
+		return nil, err
+	}
+
+	type tagUsage struct {
+		tag      TagModel
+		articles int64
+	}
+	usages := make([]tagUsage, 0, len(models))
+	for _, tag := range models {
+		var articles int64
+		err := db.Table("article_tags").
+			Joins("JOIN article_models ON article_models.id = article_tags.article_model_id AND article_models.deleted_at IS NULL").
+			Where("article_tags.tag_model_id = ?", tag.ID).
+			Count(&articles).Error
+		if err != nil {
+			return nil, err
+		}
+		if articles > 0 {
+			usages = append(usages, tagUsage{tag: tag, articles: articles})
+		}
+	}
+
+	sort.SliceStable(usages, func(i, j int) bool {
+		return usages[i].articles > usages[j].articles
+	})
+	popular := make([]TagModel, 0, len(usages))
+	for _, usage := range usages {
+		popular = append(popular, usage.tag)
+	}
+	return popular, nil
+}
